# {{ ansible_managed }}
[Unit]
Description=Todolist (Django + Gunicorn)
After=network.target

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
# Secrets et réglages de l'appli (fichier généré par Ansible, lisible par root seul).
# Le "-" rend le fichier optionnel.
EnvironmentFile=-/etc/todolist/todolist.env
ExecStart={{ app_venv }}/bin/gunicorn --workers 3 --bind 0.0.0.0:{{ app_port }} --access-logfile - todo.wsgi:application
Restart=on-failure
RestartSec=3

# Écouter sur le port 80 sans être root : on donne uniquement cette capacité
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
