# {{ ansible_managed }}
# Contient des secrets : lisible par root uniquement (systemd le lit avant de
# lancer l'appli sous l'utilisateur {{ app_user }}).
DJANGO_DEBUG={{ 'true' if django_debug | bool else 'false' }}
DJANGO_SECRET_KEY={{ django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ ansible_host }},localhost,127.0.0.1
DJANGO_DB_PATH={{ app_data_dir }}/db.sqlite3
TODOLIST_ADMIN_PASSWORD={{ todolist_admin_password }}
